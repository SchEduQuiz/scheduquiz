{
  "version": 2,
  "framework": null,
  "installCommand": "echo \"No install needed - shipping the prebuilt bundle in static-dist/\"",
  "buildCommand": "echo \"No build needed - static-dist/ already contains the production build\"",
  "outputDirectory": "static-dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|manifest.json|sw.js|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
